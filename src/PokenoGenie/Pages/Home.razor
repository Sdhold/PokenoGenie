@page "/"

<PageTitle>Pokeno Genie</PageTitle>

@if (string.Equals(View, "display", StringComparison.OrdinalIgnoreCase))
{
    <DisplayView InitialRoomCode="@Room" />
}
else if (string.Equals(View, "boards", StringComparison.OrdinalIgnoreCase))
{
    <BoardLibraryPage />
}
else
{
    <ControllerView />
}

@code {
    [SupplyParameterFromQuery(Name = "view")] public string? View { get; set; }
    [SupplyParameterFromQuery(Name = "room")] public string? Room { get; set; }
}
