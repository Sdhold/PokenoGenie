@using PokenoGenie.Core
@using PokenoGenie.Services
@using System.Text.Json
@implements IDisposable
@inject BoardLibraryService Boards
@inject FirebaseRoomService Rooms
@inject IJSRuntime JS

<main class="board-library" aria-labelledby="board-library-title">
    <div class="library-title-row"><div><span class="eyebrow">AVAILABLE TO EVERY ROOM</span><h1 id="board-library-title">Board library.</h1></div><button class="small-button" @onclick="Close">Return to table</button></div>
    @if (_draft is not null)
    {
        <BoardEditor @key="_draft.Id" Draft="_draft" Saved="OnSavedAsync" Closed="CloseEditorAsync" />
    }
    else
    {
        <p>Save each physical board once. Every caller can use these layouts to check a win.</p>
        <details class="library-editor-access" open="@(!Boards.Editor.CanEdit)">
            <summary>@(Boards.Editor.CanEdit ? "Library editor access ✓" : "Editor sign-in / setup")</summary>
            @if (Boards.Editor.CanEdit)
            {
                <p>You can add and edit shared boards. Your caller table keeps its existing identity.</p>
                @if (Boards.Editor.IsAnonymous)
                {
                    <p>Make this approved editor recoverable on another device:</p>
                    @EditorCredentials
                    <button class="small-button" disabled="@_busy" @onclick="LinkAccountAsync">Save editor login</button>
                }
                else { <p>Signed in as @Boards.Editor.Email</p><button class="small-button" disabled="@_busy" @onclick="SignOutAsync">Sign out of editing</button> }
            }
            else
            {
                @EditorCredentials
                <button class="secondary-button" disabled="@_busy" @onclick="SignInAsync">Sign in to edit</button>
                <p class="fine-print">Everyone can use published boards. An administrator approves editors in Firebase.</p>
                <details><summary>Administrator: approve this device</summary><p>Add this editor ID with the value <strong>true</strong> under <strong>boardEditors</strong> in Firebase Realtime Database. Then save an editor login here. See the deployment guide for the one-time setup.</p><code class="editor-access-id">@Boards.Editor.Uid</code><button class="small-button" @onclick="CopyEditorIdAsync">Copy editor ID</button></details>
            }
        </details>

        @if (Boards.Editor.CanEdit)
        {
            var drafts = CombinedDrafts;
            @if (drafts.Count > 0)
            {
                <section class="library-drafts"><h2>Continue a draft</h2>@foreach (var draft in drafts) { <button class="library-draft" @onclick="() => OpenDraft(draft)"><span><strong>@draft.Label</strong><small>@(draft.Cards.Count(value => PlayingCard.FromId(value) is not null)) / 25 entered · @SetName(draft.SetId)</small></span><span>Continue →</span></button> }</section>
            }
            <div class="library-create-set"><label class="library-field">New set name<input maxlength="60" @bind="_newSetName" @bind:event="oninput" placeholder="Our Pokeno set" /></label><button class="small-button" disabled="@(_busy || string.IsNullOrWhiteSpace(_newSetName))" @onclick="CreateSetAsync">Create set</button></div>
        }

        @if (Boards.Sets.Count == 0)
        {
            <div class="library-empty"><h2>No boards yet.</h2><p>An approved editor can create a set and enter its boards. Once published, every room can select them.</p></div>
        }
        else
        {
            <label class="library-field">Board set<select @bind="_setId"><option value="">Choose a set</option>@foreach (var set in Boards.Sets) { <option value="@set.Id">@set.Name (@set.Boards.Count(pair => !pair.Value.Archived) boards)</option> }</select></label>
            @if (CurrentSet is { } collection)
            {
                <div class="library-actions">
                    @if (Boards.Editor.CanEdit) { <button class="primary-button" disabled="@_busy" @onclick="AddBoardAsync">Add existing board</button><button class="secondary-button" @onclick="() => _generate = !_generate">Generate custom boards</button> }
                    <button class="small-button" disabled="@_busy" @onclick="ExportAsync">Export backup</button>
                    <button class="small-button" disabled="@(_busy || !collection.Boards.Any(pair => !pair.Value.Archived))" @onclick="PrintAsync">Print / Save PDF</button>
                </div>
                <label class="library-field">Print theme<select @bind="_printTheme">@foreach (var theme in DeckThemeCatalog.All) { <option value="@theme.Id">@theme.Name</option> }</select></label>
                @if (_generate && Boards.Editor.CanEdit)
                {
                    <section class="library-generator"><h2>Create a themed set</h2><p>Generate different 25-card layouts, review them, and publish them before printing. Printing uses the theme selected above.</p><label class="library-field">Number of boards<input type="number" min="1" max="50" @bind="_generateCount" /></label><button class="primary-button" disabled="@_busy" @onclick="GenerateAsync">Generate drafts</button></section>
                }
                <label class="library-field">Find a board<input @bind="_search" @bind:event="oninput" placeholder="Board number or label" /></label>
                @if (Boards.Editor.CanEdit) { <label class="library-check"><input type="checkbox" @bind="_showArchived" /> Show archived boards</label> }
                <ul class="library-board-list">
                    @foreach (var pair in collection.Boards.Where(pair => (_showArchived || !pair.Value.Archived) && pair.Value.Label.Contains(_search, StringComparison.OrdinalIgnoreCase)).OrderBy(pair => pair.Value.Label, StringComparer.OrdinalIgnoreCase))
                    {
                        <li><div><strong>@pair.Value.Label</strong><small>@(pair.Value.Archived ? "Archived · can restore" : "Ready · saved in Firebase")</small></div><div class="library-inline-actions"><button class="small-button" disabled="@_busy" @onclick="() => PreviewAsync(pair.Key, pair.Value)">View</button>@if (Boards.Editor.CanEdit) { <button class="small-button" disabled="@_busy" @onclick="() => EditAsync(pair.Key, pair.Value)">Edit</button><button class="text-button" disabled="@_busy" @onclick="() => ArchiveAsync(pair.Key, pair.Value)">@(pair.Value.Archived ? "Restore" : "Archive")</button> }</div></li>
                    }
                </ul>
                @if (_preview is not null)
                {
                    <section class="library-preview"><div class="library-section-heading"><h2>@_preview.Label</h2><button class="small-button" @onclick="() => _preview = null">Close preview</button></div><BoardCardGrid Cards="_preview.Cards" ThemeId="@_printTheme" /></section>
                }
                @if (Boards.Editor.CanEdit)
                {
                    <details class="library-import"><summary>Import a board-set backup</summary><p>Choose a Pokeno board-set JSON file. Imports become drafts for review; existing boards are preserved.</p><InputFile OnChange="ReadImportAsync" accept=".json,application/json" />
                        @if (_import is not null) { <p>@_import.Boards.Count layouts from “@_import.Name”. Matching labels will receive an “import” suffix. Review each draft before publishing.</p><button class="small-button" disabled="@_busy" @onclick="ImportAsync">Import as drafts into this set</button> }
                    </details>
                }
            }
        }
    }
    @if (_message is not null) { <p class="library-success" role="status">@_message</p> }
    @if (_error is not null) { <p class="library-error" role="alert">@_error</p> }
    @if (Boards.LastError is not null) { <p class="library-error" role="alert">@Boards.LastError</p> }
</main>

@code {
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public string ThemeId { get; set; } = DeckThemeCatalog.DefaultId;
    private string _email = "", _password = "", _newSetName = "", _setId = "", _search = "", _printTheme = DeckThemeCatalog.DefaultId;
    private string? _error, _message;
    private bool _busy, _generate, _showArchived;
    private int _generateCount = 12;
    private BoardDraft? _draft;
    private BoardRevision? _preview;
    private BoardPack? _import;
    private List<BoardDraft> _local = [];
    private BoardSet? CurrentSet => Boards.Sets.FirstOrDefault(set => set.Id == _setId);
    private string SetName(string id) => Boards.Sets.FirstOrDefault(set => set.Id == id)?.Name ?? "Saved set";
    private List<BoardDraft> CombinedDrafts => Boards.Drafts.Concat(_local).GroupBy(draft => draft.Id)
        .Select(group => group.OrderByDescending(draft => draft.PendingSync).ThenByDescending(draft => draft.UpdatedAt).First()).OrderByDescending(draft => draft.UpdatedAt).ToList();
    private RenderFragment EditorCredentials => @<div class="library-login"><label class="library-field">Editor email<input type="email" autocomplete="username" @bind="_email" /></label><label class="library-field">Editor password<input type="password" autocomplete="current-password" @bind="_password" /></label></div>;

    protected override async Task OnInitializedAsync()
    {
        _printTheme = DeckThemeCatalog.FindOrDefault(ThemeId).Id;
        Boards.Changed += Changed;
        await RunAsync(async () => { await Boards.InitializeAsync(); await Boards.OpenEditorAsync(); _local = await Boards.LocalDraftsAsync(); });
        _setId = Boards.Sets.FirstOrDefault()?.Id ?? "";
    }
    private void Changed() => _ = InvokeAsync(() => { if (_setId.Length == 0) _setId = Boards.Sets.FirstOrDefault()?.Id ?? ""; StateHasChanged(); });
    private async Task RunAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true; _error = null; _message = null;
        try { await action(); }
        catch (Exception error) { _error = BoardLibraryService.FriendlyError(error); }
        finally { _busy = false; }
    }
    private async Task SignInAsync() { await RunAsync(() => Boards.SignInAsync(_email, _password)); _password = ""; _local = await Boards.LocalDraftsAsync(); }
    private async Task LinkAccountAsync() { await RunAsync(() => Boards.LinkAccountAsync(_email, _password)); _password = ""; }
    private async Task SignOutAsync() { await RunAsync(() => Boards.SignOutAsync()); _local = []; }
    private async Task CopyEditorIdAsync() => await RunAsync(async () => { await Rooms.CopyTextAsync(Boards.Editor.Uid); _message = "Editor ID copied."; });
    private async Task CreateSetAsync() => await RunAsync(async () => { _setId = await Boards.CreateSetAsync(_newSetName); _newSetName = ""; });
    private string NextLabel()
    {
        var existing = (CurrentSet?.Boards.Values.Select(board => board.Label) ?? []).Concat(CombinedDrafts.Where(draft => draft.SetId == _setId).Select(draft => draft.Label)).ToHashSet(StringComparer.OrdinalIgnoreCase);
        for (var number = 1; ; number++) { var candidate = $"Board {number:00}"; if (!existing.Contains(candidate)) return candidate; }
    }
    private async Task AddBoardAsync() => await RunAsync(async () =>
    {
        _draft = new() { SetId = _setId, Label = NextLabel() }; await Boards.SaveDraftAsync(_draft);
    });
    private void OpenDraft(BoardDraft draft) { _draft = draft.Copy(); _setId = draft.SetId; _error = null; _message = null; }
    private async Task CloseEditorAsync() { _draft = null; _local = await Boards.LocalDraftsAsync(); }
    private async Task OnSavedAsync(bool next)
    {
        _draft = null; _local = await Boards.LocalDraftsAsync(); _message = "Board saved to the shared library. Every room can use it.";
        if (next) await AddBoardAsync();
    }
    private async Task PreviewAsync(string boardId, BoardSummary summary) => await RunAsync(async () => _preview = await Boards.RevisionAsync(boardId, summary.RevisionId));
    private async Task EditAsync(string boardId, BoardSummary summary) => await RunAsync(async () =>
    {
        var revision = await Boards.RevisionAsync(boardId, summary.RevisionId);
        _draft = new() { SetId = _setId, BoardId = boardId, BaseRevisionId = summary.RevisionId, Label = revision.Label, Cards = [.. revision.Cards] };
        await Boards.SaveDraftAsync(_draft);
    });
    private async Task ArchiveAsync(string boardId, BoardSummary summary) => await RunAsync(() => Boards.ArchiveAsync(_setId, boardId, summary.RevisionId, !summary.Archived));
    private async Task ExportAsync() => await RunAsync(() => Boards.ExportAsync(_setId));
    private async Task PrintAsync() => await RunAsync(() => Boards.PrintAsync(_setId, _printTheme));
    private async Task GenerateAsync() => await RunAsync(async () =>
    {
        if (_generateCount is < 1 or > 50) throw new InvalidOperationException("Generate 1–50 boards at a time.");
        var hashes = (CurrentSet?.Boards.Values.Select(board => board.LayoutHash) ?? []).ToHashSet();
        var labels = (CurrentSet?.Boards.Values.Select(board => board.Label) ?? []).Concat(CombinedDrafts.Select(draft => draft.Label)).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var number = 1;
        for (var count = 0; count < _generateCount; count++)
        {
            List<string> cards;
            do { cards = DeckShuffler.Shuffle().Take(25).ToList(); } while (!hashes.Add(BoardLayouts.Hash(cards)));
            string boardLabel; do { boardLabel = $"Board {number++:00}"; } while (!labels.Add(boardLabel));
            await Boards.SaveDraftAsync(new() { SetId = _setId, Label = boardLabel, Cards = cards, UpdatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() });
        }
        _generate = false; _local = await Boards.LocalDraftsAsync(); _message = $"Created {_generateCount} drafts. Review and publish them before printing or playing.";
    });
    private async Task ReadImportAsync(InputFileChangeEventArgs args) => await RunAsync(async () =>
    {
        _import = null;
        using var reader = new StreamReader(args.File.OpenReadStream(2 * 1024 * 1024));
        var pack = JsonSerializer.Deserialize<BoardPack>(await reader.ReadToEndAsync(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (pack is null || pack.SchemaVersion != 1 || pack.Boards is null || pack.Boards.Count is < 1 or > 200 || pack.Boards.Any(board => BoardLayouts.Validate(board.Cards).Count > 0 || string.IsNullOrWhiteSpace(board.Label) || board.Label.Length > 60))
            throw new InvalidOperationException("Choose a version 1 board pack with 1–200 valid, labelled 25-card boards.");
        _import = pack;
    });
    private async Task ImportAsync() => await RunAsync(async () =>
    {
        if (_import is null) return;
        var labels = (CurrentSet?.Boards.Values.Select(board => board.Label) ?? []).Concat(CombinedDrafts.Select(draft => draft.Label)).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var hashes = (CurrentSet?.Boards.Values.Select(board => board.LayoutHash) ?? []).Concat(CombinedDrafts.Where(draft => BoardLayouts.Validate(draft.Cards).Count == 0).Select(draft => BoardLayouts.Hash(draft.Cards))).ToHashSet();
        var skipped = 0; var added = 0;
        foreach (var board in _import.Boards)
        {
            if (!hashes.Add(BoardLayouts.Hash(board.Cards))) { skipped++; continue; }
            var boardLabel = board.Label.Trim(); var suffix = 1;
            while (!labels.Add(boardLabel)) boardLabel = $"{board.Label[..Math.Min(board.Label.Length, 44)]} (import {suffix++})";
            await Boards.SaveDraftAsync(new() { SetId = _setId, Label = boardLabel, Cards = [.. board.Cards], UpdatedAt = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() }); added++;
        }
        _import = null; _local = await Boards.LocalDraftsAsync(); _message = $"Imported {added} drafts; skipped {skipped} identical layouts. Review each draft before publishing.";
    });
    public void Dispose() { Boards.Changed -= Changed; }
    private sealed class BoardPack { public int SchemaVersion { get; set; } public string Name { get; set; } = ""; public List<BoardRevision> Boards { get; set; } = []; }
}
