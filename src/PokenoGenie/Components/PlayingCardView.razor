@using PokenoGenie.Core

@if (Card is null)
{
    <div class="playing-card card-back @Class" role="img" aria-label="Face-down card">
        <div class="card-back-inner"><span>✦</span><strong>PG</strong><span>✦</span></div>
    </div>
}
else
{
    <div class="playing-card @(Card.IsRed ? "red-suit" : "black-suit") @Class"
         role="img" aria-label="@Card.AccessibleName">
        <div class="card-corner"><strong>@Card.Rank</strong><span>@Card.Suit</span></div>
        <div class="card-suit">@Card.Suit</div>
        <div class="card-corner card-corner-bottom"><strong>@Card.Rank</strong><span>@Card.Suit</span></div>
    </div>
}

@code {
    [Parameter] public PlayingCard? Card { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
}
